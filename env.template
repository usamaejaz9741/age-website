# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local or any .env files to version control

# ===========================================
# API KEYS (REQUIRED)
# ===========================================

# Google Gemini AI API Key
# Get your API key from: https://makersuite.google.com/app/apikey
# Format: AIzaSy... (starts with AIzaSy)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# DATABASE CONFIGURATION (REQUIRED)
# ===========================================

# Supabase Project URL
# Get this from your Supabase project settings
# Format: https://your-project-id.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anonymous Key
# Get this from your Supabase project settings
# Format: eyJ... (JWT token starting with eyJ)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===========================================
# ANALYTICS (OPTIONAL)
# ===========================================

# Google Analytics Tracking ID
# Get your tracking ID from Google Analytics
# Format: G-XXXXXXXXXX or UA-XXXXXXXXX-X
VITE_GA_TRACKING_ID=your_ga_tracking_id

# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================

# Environment Mode
# Set to 'production' for production builds
NODE_ENV=development

# ===========================================
# SECURITY NOTES
# ===========================================
# 
# 1. NEVER commit this file or .env.local to version control
# 2. Use different API keys for development and production
# 3. Rotate API keys regularly
# 4. Use environment-specific values
# 5. Keep API keys secure and don't share them
# 6. Use Vercel environment variables for production deployment
